{
  "$schema": "https://json.schemastore.org/github-labels",
  "labels": [
    { "name": "🐛 TYPE: Bug",                "color": "d73a4a", "description": "Something is broken" },
    { "name": "✨ TYPE: Feature",            "color": "a2eeef", "description": "New feature or capability" },
    { "name": "📚 TYPE: Docs",               "color": "0075ca", "description": "Documentation work" },
    { "name": "🧹 TYPE: Chore",              "color": "cfd3d7", "description": "Maintenance, build, deps" },
    { "name": "🔨 TYPE: Refactor",           "color": "c2e0c6", "description": "Restructure without behavior change" },
    { "name": "⚡ TYPE: Performance",         "color": "fbca04", "description": "Performance optimization" },
    { "name": "🔒 TYPE: Security",           "color": "b60205", "description": "Vulnerability or hardening" },
    { "name": "🧪 TYPE: Test",               "color": "bfdadc", "description": "Test coverage or test infrastructure" },
    { "name": "🔬 TYPE: Spike",              "color": "c5def5", "description": "Time-boxed investigation / research" },
    { "name": "❓ TYPE: Question",            "color": "d876e3", "description": "Question or discussion" },

    { "name": "🚦 STATUS: Triage",           "color": "fef2c0", "description": "Awaiting initial triage" },
    { "name": "🚧 STATUS: In Progress",      "color": "f9d71c", "description": "Actively being worked on" },
    { "name": "🔴 STATUS: Blocked",          "color": "e11d21", "description": "Blocked by an unresolved dependency" },
    { "name": "👀 STATUS: Needs Review",     "color": "5319e7", "description": "Waiting on code review" },
    { "name": "💬 STATUS: Needs Info",       "color": "bfd4f2", "description": "Waiting for more info from reporter" },
    { "name": "🥶 STATUS: Stale",            "color": "cccccc", "description": "Inactive for a long time" },

    { "name": "👯 RESOLUTION: Duplicate",    "color": "cfd3d7", "description": "Already exists" },
    { "name": "🚫 RESOLUTION: Invalid",      "color": "e4e669", "description": "Not a valid issue" },
    { "name": "🙅 RESOLUTION: Wontfix",      "color": "eeeeee", "description": "Acknowledged but will not be fixed" },
    { "name": "🎯 RESOLUTION: By Design",    "color": "c2e0c6", "description": "Intentional behavior" },

    { "name": "🔥 PRIORITY: P0",             "color": "b60205", "description": "Critical — drop everything" },
    { "name": "⬆️ PRIORITY: P1",             "color": "d93f0b", "description": "High priority" },
    { "name": "➡️ PRIORITY: P2",             "color": "fbca04", "description": "Medium priority (default)" },
    { "name": "⬇️ PRIORITY: P3",             "color": "0e8a16", "description": "Low priority / backlog" },

    { "name": "🌱 COMMUNITY: Good First Issue", "color": "7057ff", "description": "Good entry point for new contributors" },
    { "name": "🙏 COMMUNITY: Help Wanted",   "color": "008672", "description": "Looking for collaborators" },

    { "name": "💥 BREAKING CHANGE",          "color": "b60205", "description": "Backwards-incompatible change" },
    { "name": "📦 DEPENDENCIES",             "color": "0366d6", "description": "Dependency updates (Renovate / Dependabot)" },
    { "name": "🤖 AUTOMATED",                "color": "ededed", "description": "Created by an automated bot" }
  ],
  "renames": [
    { "from": "🦠 TYPE: Bug",                "to": "🐛 TYPE: Bug" },
    { "from": "❤️‍🔥 TYPE: Feature",          "to": "✨ TYPE: Feature" },
    { "from": "🔥 TYPE: Feature",            "to": "✨ TYPE: Feature" },
    { "from": "✂️ TYPE: Testing",            "to": "🧪 TYPE: Test" },
    { "from": "🍡 TYPE: Spike",              "to": "🔬 TYPE: Spike" },
    { "from": "🚩 ACTION: Triage",           "to": "🚦 STATUS: Triage" },
    { "from": "🥤 ACTION: Refine",           "to": "💬 STATUS: Needs Info" },

    { "from": "🔨 ACTION: question",         "to": "❓ TYPE: Question" },
    { "from": "✂️ ACTION: Question",         "to": "❓ TYPE: Question" },
    { "from": "🔨 ACTION: help wanted",      "to": "🙏 COMMUNITY: Help Wanted" },
    { "from": "✂️ ACTION: Help",             "to": "🙏 COMMUNITY: Help Wanted" },
    { "from": "🔨 ACTION: duplicate",        "to": "👯 RESOLUTION: Duplicate" },
    { "from": "✂️ ACTION: Duplicated",       "to": "👯 RESOLUTION: Duplicate" },
    { "from": "🔨 ACTION: invalid",          "to": "🚫 RESOLUTION: Invalid" },
    { "from": "🈵 ACTION: invalid",          "to": "🚫 RESOLUTION: Invalid" },
    { "from": "✂️ ACTION: Invalid",          "to": "🚫 RESOLUTION: Invalid" },
    { "from": "🔨 ACTION: wontfix",          "to": "🙅 RESOLUTION: Wontfix" },
    { "from": "✂️ ACTION: No Fix",           "to": "🙅 RESOLUTION: Wontfix" },

    { "from": "🧨 BREAKING CHANGE",          "to": "💥 BREAKING CHANGE" },

    { "from": "bug",                          "to": "🐛 TYPE: Bug" },
    { "from": "documentation",                "to": "📚 TYPE: Docs" },
    { "from": "enhancement",                  "to": "✨ TYPE: Feature" },
    { "from": "question",                     "to": "❓ TYPE: Question" },
    { "from": "duplicate",                    "to": "👯 RESOLUTION: Duplicate" },
    { "from": "invalid",                      "to": "🚫 RESOLUTION: Invalid" },
    { "from": "wontfix",                      "to": "🙅 RESOLUTION: Wontfix" },
    { "from": "good first issue",             "to": "🌱 COMMUNITY: Good First Issue" },
    { "from": "help wanted",                  "to": "🙏 COMMUNITY: Help Wanted" },
    { "from": "dependencies",                 "to": "📦 DEPENDENCIES" }
  ],
  "deletions": [
    "♨️ ACTION: pull request",
    "☕ ACTION: Pull Request",
    "⚗️ ACTION: research",
    "🛸 ACTION: Research",
    "🩹 ACTION: fix",
    "🔭 TYPE: Request"
  ]
}
