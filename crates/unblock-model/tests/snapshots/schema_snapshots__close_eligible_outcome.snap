{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloseEligibleOutcome",
  "description": "The outcome of closing every eligible epic (`issue action: close_eligible`, FR-6 / D56).",
  "type": "object",
  "properties": {
    "count": {
      "description": "The number of entries in `epic_ids`.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "dry_run": {
      "description": "Whether this was a dry run (nothing written).",
      "type": "boolean"
    },
    "epic_ids": {
      "description": "The epic ids closed (or, on a dry run, that would close), in close order: by cascade round,\nthen by id ascending, so every child epic precedes its parent.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "epic_ids",
    "count",
    "dry_run"
  ]
}
