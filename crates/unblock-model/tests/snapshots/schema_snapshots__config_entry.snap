---
source: crates/unblock-model/tests/schema_snapshots.rs
expression: json
---
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ConfigEntry",
  "description": "One runtime configuration entry (`issue action: config`, FR-13 / D57).",
  "type": "object",
  "properties": {
    "effective": {
      "description": "The canonical value this session resolved, or null when the key is not a runtime layer key.",
      "type": [
        "string",
        "null"
      ]
    },
    "fault": {
      "description": "The row's fault, or null for a sound or absent row.",
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigFault"
        },
        {
          "type": "null"
        }
      ]
    },
    "key": {
      "description": "The configuration key.",
      "type": "string"
    },
    "source": {
      "description": "The layer that supplied `effective`, or null when the key is not a runtime layer key.",
      "anyOf": [
        {
          "$ref": "#/$defs/ConfigSource"
        },
        {
          "type": "null"
        }
      ]
    },
    "value": {
      "description": "The database `config` row's value, or null when no row holds the key.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "key"
  ],
  "$defs": {
    "ConfigFault": {
      "description": "A database `config` row's fault.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "What is wrong with the row.",
          "$ref": "#/$defs/ConfigFaultKind"
        },
        "reason": {
          "description": "A human description of the fault.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ]
    },
    "ConfigFaultKind": {
      "description": "Why a database `config` row contributes no value.",
      "oneOf": [
        {
          "description": "The row names a startup key, which only the command line, the environment and the project\nfile may set. Blocking.",
          "type": "string",
          "const": "startup_key"
        },
        {
          "description": "The row's value cannot be decoded for its key. Blocking.",
          "type": "string",
          "const": "invalid_value"
        },
        {
          "description": "The row names a key this build does not know. Not blocking.",
          "type": "string",
          "const": "unknown_key"
        }
      ]
    },
    "ConfigSource": {
      "description": "The layer that supplied a resolved runtime configuration value, highest precedence first.",
      "oneOf": [
        {
          "description": "A command-line flag.",
          "type": "string",
          "const": "cli"
        },
        {
          "description": "An `UNBLOCK_*` environment variable.",
          "type": "string",
          "const": "env"
        },
        {
          "description": "The project file, `.unblock/config.toml`.",
          "type": "string",
          "const": "project"
        },
        {
          "description": "The user file, `config.toml` under the user configuration directory.",
          "type": "string",
          "const": "user"
        },
        {
          "description": "A row of the database `config` table.",
          "type": "string",
          "const": "db"
        },
        {
          "description": "The operating-system user name (the actor's `$USER` fallback).",
          "type": "string",
          "const": "os_user"
        },
        {
          "description": "The built-in default.",
          "type": "string",
          "const": "default"
        }
      ]
    }
  }
}
