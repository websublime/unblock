            "null"
          ]
        },
        "compacted_at_commit": {
          "description": "The commit at which the issue was compacted.",
          "type": [
            "string",
            "null"
          ]
        },
        "compaction_level": {
          "default": 0,
          "description": "Compaction level (kept for JSONL round-trip fidelity, D12). `None` serializes as `0`.",
          "format": "int32",
          "type": [
