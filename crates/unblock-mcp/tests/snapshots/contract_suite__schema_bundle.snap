        "Comment": {
          "description": "A comment on an issue (spine §1.7; v1 surface — D37). Flat: no threading (FORK-T).",
          "properties": {
            "author": {
              "description": "The comment author (= the session actor at the MCP surface, FORK-M1b).",
              "type": "string"
            },
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "id": {
              "description": "Stable comment id.",
              "format": "int64",
              "type": "integer"
            },
            "issue_id": {
              "description": "The issue this comment belongs to.",
              "type": "string"
            },
            "redacted_at": {
              "description": "Soft-redact marker (D37/D-E): `None` = live; `Some` = redacted.\n\nThe PRESENCE is the \"is redacted\" flag (mirroring the tombstone `deleted_at`); on redact the\nrow is KEPT and `body` is masked to `\"\"`. The `CommentRedacted` audit event retains the\noriginal body (provenance — FORK-redact-wire).",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "description": "The comment body (serialized under `\"text\"`); masked to `\"\"` on redact.",
              "type": "string"
            },
            "updated_at": {
              "description": "Provenance-preserving edit instant (D37/D-D): `None` = never edited; `Some` = last edit.\n\n`add`'s own INSERT is create-time-only — see spine §3.2.1 MUST-1 SCOPE.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "issue_id",
            "author",
            "text",
            "created_at"
          ],
          "type": "object"
        },
        "DeleteModeOutput": {
          "description": "The delete mode on the output wire (spine §5.3, D25) — mcp-owned, from the RESOLVED model\n[`DeleteMode`] (an OUTPUT type, distinct from the input `DeleteModeInput`).",
          "oneOf": [
            {
              "const": "tombstone",
              "description": "Soft-delete: tombstone the targets.",
              "type": "string"
            },
            {
              "const": "cascade",
              "description": "Tombstone the targets and their children.",
              "type": "string"
            },
            {
              "const": "hard",
              "description": "Permanently delete the rows.",
              "type": "string"
            },
            {
              "const": "dry_run",
              "description": "Compute the plan only; mutate nothing.",
              "type": "string"
            }
          ]
        },
        "DeletePlanOutput": {
          "description": "The resolved `delete` plan output (spine §5.3, D25) — was the ad-hoc `delete_plan_json`.",
          "properties": {
            "cascade_children": {
              "description": "The child ids the chosen mode will also affect.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
