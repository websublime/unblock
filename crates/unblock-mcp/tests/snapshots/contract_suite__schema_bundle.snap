  "dep": {
    "$defs": {
      "DependencyType": {
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `dep` tool input (spine §5.2 — EXACT shape; was `DepInput2`).",
    "oneOf": [
      {
        "description": "Add a dependency edge (cycle-rejecting).",
        "properties": {
          "action": {
            "const": "add",
            "type": "string"
          },
          "agent_name": {
            "default": null,
            "description": "Self-reported agent name (capture-only).",
            "type": [
              "string",
              "null"
            ]
          },
          "dep_type": {
            "$ref": "#/$defs/DependencyType",
            "description": "The dependency type."
          },
          "depends_on_id": {
            "description": "The blocker issue id.",
            "type": "string"
          },
          "harness": {
            "default": null,
            "description": "Self-reported harness identifier (capture-only).",
            "type": [
              "string",
              "null"
            ]
          },
          "issue_id": {
            "description": "The dependent issue id.",
            "type": "string"
          },
          "metadata": {
            "default": null,
            "description": "Optional JSON metadata for the edge.",
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "default": null,
            "description": "Self-reported model identifier (capture-only).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action",
          "issue_id",
          "depends_on_id",
          "dep_type"
        ],
        "type": "object"
      },
      {
        "description": "Remove a dependency edge.",
        "properties": {
          "action": {
            "const": "remove",
            "type": "string"
          },
          "agent_name": {
            "default": null,
            "description": "Self-reported agent name (capture-only).",
            "type": [
              "string",
              "null"
            ]
          },
          "dep_type": {
            "$ref": "#/$defs/DependencyType",
            "description": "The dependency type."
          },
          "depends_on_id": {
            "description": "The blocker issue id.",
            "type": "string"
          },
          "harness": {
            "default": null,
            "description": "Self-reported harness identifier (capture-only).",
            "type": [
              "string",
              "null"
            ]
          },
          "issue_id": {
            "description": "The dependent issue id.",
            "type": "string"
          },
          "model": {
            "default": null,
            "description": "Self-reported model identifier (capture-only).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action",
          "issue_id",
          "depends_on_id",
          "dep_type"
        ],
        "type": "object"
      },
      {
        "description": "List the direct edges declared by an issue.",
        "properties": {
          "action": {
            "const": "list",
            "type": "string"
          },
          "id": {
            "description": "The issue id.",
            "type": "string"
          }
        },
        "required": [
          "action",
          "id"
        ],
        "type": "object"
      },
      {
        "description": "The dependency subtree rooted at an issue.",
        "properties": {
          "action": {
            "const": "tree",
            "type": "string"
          },
          "id": {
            "description": "The root issue id.",
            "type": "string"
          }
        },
        "required": [
          "action",
          "id"
        ],
        "type": "object"
      },
      {
        "description": "Detect dependency cycles.",
        "properties": {
          "action": {
            "const": "cycles",
            "type": "string"
          },
          "blocking_only": {
            "default": true,
            "description": "Restrict to gating edges only (default TRUE; `false` = all dep types, D19).",
            "type": "boolean"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      {
        "description": "The dependency graph for a root set (empty roots = the whole graph).",
        "properties": {
          "action": {
            "const": "graph",
            "type": "string"
          },
          "roots": {
            "default": [],
            "description": "The root ids (empty = the whole graph).",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    ],
    "title": "DepToolInput"
  },
  "sync": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `sync` tool input (spine §5.2 — EXACT shape).",
    "oneOf": [
      {
        "description": "Export the store to JSONL (default path `.unblock/issues.jsonl`).",
        "properties": {
          "action": {
            "const": "export",
            "type": "string"
          },
          "path": {
            "default": null,
            "description": "Optional export path (path-confined to the workspace).",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      },
      {
        "description": "Import JSONL.",
        "properties": {
          "action": {
            "const": "import",
            "type": "string"
          },
          "dry_run": {
            "default": false,
            "description": "Plan-only: report the import without writing.",
            "type": "boolean"
          },
          "path": {
            "description": "The JSONL path to import.",
            "type": "string"
          }
        },
        "required": [
          "action",
          "path"
        ],
        "type": "object"
      },
      {
        "description": "One-shot, idempotent `bd` import (D16).",
        "properties": {
          "action": {
            "const": "import_bd",
            "type": "string"
          },
          "path": {
            "description": "The `bd` export path to import.",
            "type": "string"
          }
        },
        "required": [
          "action",
          "path"
        ],
        "type": "object"
      }
    ],
    "title": "SyncInput"
  },
  "diagnostics": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "The `diagnostics` tool input (spine §5.2 — EXACT shape; mirrors [`DiagnosticKind`]).",
    "oneOf": [
      {
        "description": "Aggregate statistics.",
        "properties": {
          "kind": {
            "const": "stats",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "General workspace info.",
        "properties": {
          "kind": {
            "const": "info",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "Where the workspace lives.",
        "properties": {
          "kind": {
            "const": "where",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "Version information (embeds the contract version).",
        "properties": {
          "kind": {
            "const": "version",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "Lint findings.",
        "properties": {
          "kind": {
            "const": "lint",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "The changelog of closed issues (the `since` window is T2.7; dropped here).",
        "properties": {
          "kind": {
            "const": "changelog",
            "type": "string"
          },
          "since": {
            "default": null,
            "description": "Optional since-window (accepted but not yet threaded — T2.7).",
            "format": "date-time",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      {
        "description": "Orphan candidates (FR-15).",
        "properties": {
          "kind": {
            "const": "orphans",
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      }
    ],
    "title": "DiagnosticsInput"
  }
}
