            },
            "type": "array"
          },
          "kind": {
            "const": "count",
            "type": "string"
          },
          "labels_all": {
            "default": [],
            "description": "Labels that must ALL be present (AND).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "labels_any": {
