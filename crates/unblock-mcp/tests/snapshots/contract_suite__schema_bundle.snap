            "description": "Optional group-by dimension."
          },
          "include_closed": {
            "default": false,
            "description": "Include closed/tombstone issues.",
            "type": "boolean"
          },
          "include_deferred": {
            "default": false,
            "description": "Include deferred issues.",
            "type": "boolean"
          },
          "issue_type": {
            "default": [],
