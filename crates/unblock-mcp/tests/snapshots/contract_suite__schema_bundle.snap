{
  "contract_version": "unblock.mcp.v1.6",
  "issue": {
    "input": {
      "$defs": {
        "DeleteModeInput": {
          "description": "The delete mode on the wire (spine §5.2 `DeleteModeInput` → [`DeleteMode`]).",
          "oneOf": [
            {
              "const": "tombstone",
              "description": "Soft-delete (default): tombstone the targets.",
              "type": "string"
            },
            {
              "const": "cascade",
              "description": "Tombstone the targets and their children.",
              "type": "string"
            },
            {
              "const": "hard",
              "description": "Permanently delete the rows.",
              "type": "string"
            },
            {
              "const": "dry_run",
              "description": "Compute the plan only; mutate nothing.",
              "type": "string"
            }
          ]
        },
        "DepInput": {
          "additionalProperties": false,
          "description": "A dependency edge on the wire (spine §5.2 `DepInput`).\n\nUsed both as a `query`/`dep`-tool edge input and as a `Create.deps` element. The model\n[`Dependency`] additionally carries a `created_at`/`created_by` — supplied by the adapter via\n[`DepInput::into_dependency`], not by the wire.",
          "properties": {
            "dep_type": {
              "$ref": "#/$defs/DependencyType",
              "description": "The dependency type."
            },
            "depends_on_id": {
              "description": "The blocker issue id (target).",
              "type": "string"
            },
            "issue_id": {
              "description": "The dependent issue id (source).",
              "type": "string"
            },
            "metadata": {
              "default": null,
              "description": "Optional JSON metadata for the edge.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "issue_id",
            "depends_on_id",
            "dep_type"
          ],
          "type": "object"
        },
        "DependencyType": {
          "type": "string"
        },
        "IssueType": {
          "type": "string"
        },
        "Priority": {
          "description": "Issue priority (spine §1.2): a transparent newtype over `i32`, valid range `0..=4`.\n\nOrdering is numeric, so `CRITICAL < HIGH < MEDIUM < LOW < BACKLOG` — this is the order the\nhybrid ready-sort relies on. `Default` is [`Priority::MEDIUM`]. The wire form is the bare\ninteger (`#[serde(transparent)]`), and `Display` renders `\"P{n}\"`.\n\n# Examples\n\n```\nuse unblock_model::Priority;\nuse std::str::FromStr;\n\nassert_eq!(Priority::default(), Priority::MEDIUM);\nassert_eq!(Priority::CRITICAL.to_string(), \"P0\");\nassert_eq!(Priority::from_str(\"p1\").unwrap(), Priority::HIGH);\nassert!(Priority::from_str(\"P5\").is_err());\nassert!(Priority::CRITICAL < Priority::BACKLOG);\n```",
          "format": "int32",
          "type": "integer"
        },
        "Status": {
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `issue` tool input (spine §5.2 — EXACT shape; 7 actions).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Create a new issue (interactive MINTING create, D21).\n\nThe payload is boxed (it is the largest variant) — the wire shape is unchanged: a newtype\nvariant over a `#[serde(flatten)]`-equivalent struct keeps `{action:\"create\", title, ...}`.",
          "properties": {
            "acceptance_criteria": {
              "default": null,
              "description": "The `### Acceptance Criteria` / `### Acceptance` content (D22 — `NewIssue::acceptance_criteria`).",
              "type": [
