      "type": "object"
    },
    "output": {
      "$defs": {
        "Comment": {
          "description": "A comment on an issue (spine §1.7; v1 surface — D37). Flat: no threading (FORK-T).",
          "properties": {
            "author": {
              "description": "The comment author (= the session actor at the MCP surface, FORK-M1b).",
              "type": "string"
            },
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "id": {
              "description": "Stable comment id.",
              "format": "int64",
              "type": "integer"
            },
            "issue_id": {
              "description": "The issue this comment belongs to.",
              "type": "string"
            },
            "redacted_at": {
              "description": "Soft-redact marker (D37/D-E): `None` = live; `Some` = redacted.\n\nThe PRESENCE is the \"is redacted\" flag (mirroring the tombstone `deleted_at`); on redact the\nrow is KEPT and `body` is masked to `\"\"`. The `CommentRedacted` audit event retains the\noriginal body (provenance — FORK-redact-wire).",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "description": "The comment body (serialized under `\"text\"`); masked to `\"\"` on redact.",
              "type": "string"
            },
            "updated_at": {
              "description": "Provenance-preserving edit instant (D37/D-D): `None` = never edited; `Some` = last edit.\n\n`add`'s own INSERT is create-time-only — see spine §3.2.1 MUST-1 SCOPE.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "issue_id",
            "author",
            "text",
            "created_at"
          ],
          "type": "object"
        },
        "Dependency": {
          "description": "A relationship between two issues (spine §1.7).",
          "properties": {
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "created_by": {
              "description": "Who created the edge.",
              "type": [
                "string",
                "null"
              ]
            },
            "depends_on_id": {
              "description": "The issue being depended on (target).",
              "type": "string"
            },
            "issue_id": {
              "description": "The issue that has the dependency (source).",
              "type": "string"
            },
            "metadata": {
              "description": "Optional JSON metadata. A degenerate empty (or whitespace-only) string is coerced to\n`None` on deserialization to tolerate legacy JSONL that wrote `\"metadata\":\"\"`.",
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "description": "Thread id for conversation linking.",
              "type": [
                "string",
                "null"
              ]
