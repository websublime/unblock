              "type": [
                "string",
                "null"
              ]
            },
            "assignee": {
              "description": "Assigned actor.",
              "type": [
                "string",
                "null"
              ]
            },
            "close_reason": {
              "description": "Reason for closure.",
              "type": [
                "string",
                "null"
              ]
            },
            "closed_at": {
              "description": "Closure timestamp.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "closed_by_session": {
              "description": "Session id that closed this issue.",
              "type": [
                "string",
                "null"
              ]
            },
            "comments": {
              "description": "Comments (hydrated for export/display on all read paths — D37).",
              "items": {
