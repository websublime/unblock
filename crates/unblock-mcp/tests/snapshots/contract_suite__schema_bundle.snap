                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Minimum priority (inclusive)."
            },
            "status": {
              "default": [],
              "description": "Status OR-set (a match on ANY listed status).",
              "items": {
                "$ref": "#/$defs/Status"
              },
              "type": "array"
            },
            "text_contains": {
              "default": null,
              "description": "Substring match over title/description.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Stale issues (not updated since `older_than`).",
          "properties": {
            "assignee": {
              "default": null,
              "description": "Assignee equality filter.",
              "type": [
                "string",
                "null"
              ]
            },
            "include_closed": {
              "default": false,
              "description": "Include closed/tombstone issues.",
              "type": "boolean"
            },
            "include_deferred": {
              "default": false,
              "description": "Include deferred issues.",
              "type": "boolean"
            },
            "issue_type": {
              "default": [],
              "description": "Issue-type OR-set.",
              "items": {
                "$ref": "#/$defs/IssueType"
              },
              "type": "array"
            },
            "kind": {
              "const": "stale",
              "type": "string"
            },
            "labels_all": {
              "default": [],
              "description": "Labels that must ALL be present (AND).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "labels_any": {
              "default": [],
              "description": "Labels of which ANY may be present (OR).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "limit": {
              "default": null,
              "description": "Result cap (`None` = unlimited; `ready` is default-complete).",
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "offset": {
              "default": null,
              "description": "Result offset.",
              "format": "uint",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "older_than": {
              "description": "The staleness threshold.",
              "format": "date-time",
              "type": "string"
            },
            "priority_max": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Priority"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Maximum priority (inclusive)."
            },
            "priority_min": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Priority"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Minimum priority (inclusive)."
            },
            "status": {
              "default": [],
              "description": "Status OR-set (a match on ANY listed status).",
              "items": {
                "$ref": "#/$defs/Status"
              },
              "type": "array"
            },
            "text_contains": {
              "default": null,
              "description": "Substring match over title/description.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "older_than"
          ],
          "type": "object"
        }
      ],
      "title": "QueryInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Comment": {
          "description": "A comment on an issue (spine §1.7; v1 surface — D37). Flat: no threading (FORK-T).",
          "properties": {
            "author": {
              "description": "The comment author (= the session actor at the MCP surface, FORK-M1b).",
              "type": "string"
            },
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "id": {
              "description": "Stable comment id.",
              "format": "int64",
              "type": "integer"
            },
            "issue_id": {
              "description": "The issue this comment belongs to.",
              "type": "string"
            },
            "redacted_at": {
              "description": "Soft-redact marker (D37/D-E): `None` = live; `Some` = redacted.\n\nThe PRESENCE is the \"is redacted\" flag (mirroring the tombstone `deleted_at`); on redact the\nrow is KEPT and `body` is masked to `\"\"`. The `CommentRedacted` audit event retains the\noriginal body (provenance — FORK-redact-wire).",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "description": "The comment body (serialized under `\"text\"`); masked to `\"\"` on redact.",
              "type": "string"
            },
            "updated_at": {
              "description": "Provenance-preserving edit instant (D37/D-D): `None` = never edited; `Some` = last edit.\n\n`add`'s own INSERT is create-time-only — see spine §3.2.1 MUST-1 SCOPE.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "issue_id",
            "author",
            "text",
            "created_at"
          ],
          "type": "object"
        },
        "CountBucket": {
          "description": "A single count bucket from a count query.",
          "properties": {
            "count": {
              "description": "The count in this bucket.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "key": {
              "description": "The bucket key (status/type/assignee/priority/label value).",
              "type": "string"
            }
          },
          "required": [
            "key",
            "count"
          ],
          "type": "object"
        },
        "CountList": {
          "description": "The CD-2 object-wrap for `query{count}` buckets: `{\"counts\":[…]}` (spine §5.3).",
          "properties": {
            "counts": {
              "description": "The count buckets.",
              "items": {
                "$ref": "#/$defs/CountBucket"
              },
              "type": "array"
            }
          },
          "required": [
            "counts"
          ],
          "type": "object"
        },
        "Dependency": {
          "description": "A relationship between two issues (spine §1.7).",
          "properties": {
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "created_by": {
              "description": "Who created the edge.",
              "type": [
                "string",
                "null"
              ]
            },
            "depends_on_id": {
              "description": "The issue being depended on (target).",
              "type": "string"
            },
            "issue_id": {
              "description": "The issue that has the dependency (source).",
              "type": "string"
            },
            "metadata": {
              "description": "Optional JSON metadata. A degenerate empty (or whitespace-only) string is coerced to\n`None` on deserialization to tolerate legacy JSONL that wrote `\"metadata\":\"\"`.",
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "description": "Thread id for conversation linking.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "$ref": "#/$defs/DependencyType",
              "description": "The kind of dependency."
            }
          },
          "required": [
            "issue_id",
            "depends_on_id",
            "type",
            "created_at"
          ],
          "type": "object"
        },
        "DependencyType": {
          "type": "string"
        },
        "Issue": {
          "description": "The primary issue entity (spine §1.6).\n\n`content_hash` is `#[serde(skip)]` — it never appears in JSONL and is recomputed on load (it is\nthe import idempotency key, FR-26). `compaction_level` always serializes as an integer (`0` when\n`None`) for `bd` conformance. All other optional fields are omitted when empty.",
          "properties": {
            "acceptance_criteria": {
              "description": "Acceptance criteria.",
              "type": [
                "string",
                "null"
              ]
            },
            "agent_context": {
              "description": "Canonical-JSON governance document inherited by descendants.",
              "type": [
                "string",
                "null"
              ]
            },
            "assignee": {
              "description": "Assigned actor.",
              "type": [
                "string",
                "null"
              ]
            },
            "close_reason": {
              "description": "Reason for closure.",
              "type": [
                "string",
                "null"
              ]
            },
            "closed_at": {
              "description": "Closure timestamp.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "closed_by_session": {
              "description": "Session id that closed this issue.",
              "type": [
                "string",
                "null"
              ]
            },
            "comments": {
              "description": "Comments (hydrated for export/display on all read paths — D37).",
              "items": {
                "$ref": "#/$defs/Comment"
              },
              "type": "array"
            },
            "compacted_at": {
              "description": "Compaction timestamp.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "compacted_at_commit": {
              "description": "The commit at which the issue was compacted.",
              "type": [
                "string",
                "null"
              ]
            },
            "compaction_level": {
              "default": 0,
              "description": "Compaction level (kept for JSONL round-trip fidelity, D12). `None` serializes as `0`.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "created_by": {
              "description": "Creator.",
              "type": [
                "string",
                "null"
              ]
            },
            "defer_until": {
              "description": "Defer-until date.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "delete_reason": {
              "description": "Tombstone: reason for deletion.",
              "type": [
                "string",
                "null"
              ]
            },
            "deleted_at": {
              "description": "Tombstone: deletion timestamp.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "deleted_by": {
              "description": "Tombstone: who deleted the issue.",
              "type": [
                "string",
                "null"
              ]
            },
            "dependencies": {
              "description": "Dependencies (hydrated for export/display).",
              "items": {
                "$ref": "#/$defs/Dependency"
              },
              "type": "array"
            },
            "description": {
              "description": "Detailed description (unbounded by design).",
              "type": [
                "string",
                "null"
              ]
            },
            "design": {
              "description": "Technical design notes.",
              "type": [
                "string",
                "null"
              ]
            },
            "due_at": {
              "description": "Due date.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "ephemeral": {
              "description": "Whether the issue is ephemeral.",
              "type": "boolean"
            },
            "estimated_minutes": {
              "description": "Estimated effort in minutes.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "external_ref": {
              "description": "External reference (orphans derive from this; FR-15).",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "Unique id (prefix + optional slug + hash, e.g. `\"ub-abc123\"`).",
              "type": "string"
            },
            "is_template": {
              "description": "Whether the issue is a template.",
              "type": "boolean"
            },
            "issue_type": {
              "$ref": "#/$defs/IssueType",
              "default": "task",
              "description": "Issue type."
            },
            "labels": {
              "description": "Labels (hydrated for export/display).",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "notes": {
              "description": "Additional notes.",
              "type": [
                "string",
                "null"
              ]
            },
            "original_size": {
              "description": "The pre-compaction size.",
              "format": "int32",
              "type": [
                "integer",
                "null"
              ]
            },
            "original_type": {
              "description": "Tombstone: the issue type before deletion (preserved across the tombstone transition).",
              "type": [
                "string",
                "null"
              ]
            },
            "owner": {
              "description": "Issue owner.",
              "type": [
                "string",
                "null"
              ]
            },
            "pinned": {
              "description": "Whether the issue is pinned.",
              "type": "boolean"
            },
            "priority": {
              "$ref": "#/$defs/Priority",
              "default": 2,
              "description": "Priority (0=Critical, 4=Backlog)."
            },
            "sender": {
              "description": "Message sender (messaging surface).",
              "type": [
                "string",
                "null"
              ]
            },
            "source_repo": {
              "description": "Source repository basename (multi-repo support).",
              "type": [
                "string",
                "null"
              ]
            },
            "source_repo_path": {
              "description": "Absolute canonical path of the source repository.",
              "type": [
                "string",
                "null"
              ]
            },
            "source_system": {
              "description": "Source system for imported issues.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/$defs/Status",
              "default": "open",
              "description": "Workflow status."
            },
            "title": {
              "description": "Title (1..=500 chars; see [`crate::IssueValidator`]).",
              "type": "string"
            },
            "updated_at": {
              "description": "Last-update timestamp.",
              "format": "date-time",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "created_at",
            "updated_at"
          ],
          "type": "object"
        },
        "IssueList": {
          "description": "The CD-2 object-wrap for a list of issues: `{\"issues\":[…]}` (spine §5.3). Shared by\n[`IssueOutput::Issues`] (multi-id `update` / `create_bulk`) and [`QueryOutput::Issues`]\n(`list`/`ready`/`blocked`/`search`/`stale`), so `structuredContent` is an object, never a bare array.",
          "properties": {
            "issues": {
              "description": "The issues in the result set.",
              "items": {
                "$ref": "#/$defs/Issue"
              },
              "type": "array"
            }
          },
          "required": [
            "issues"
          ],
          "type": "object"
        },
        "IssueType": {
          "type": "string"
        },
        "Priority": {
          "description": "Issue priority (spine §1.2): a transparent newtype over `i32`, valid range `0..=4`.\n\nOrdering is numeric, so `CRITICAL < HIGH < MEDIUM < LOW < BACKLOG` — this is the order the\nhybrid ready-sort relies on. `Default` is [`Priority::MEDIUM`]. The wire form is the bare\ninteger (`#[serde(transparent)]`), and `Display` renders `\"P{n}\"`.\n\n# Examples\n\n```\nuse unblock_model::Priority;\nuse std::str::FromStr;\n\nassert_eq!(Priority::default(), Priority::MEDIUM);\nassert_eq!(Priority::CRITICAL.to_string(), \"P0\");\nassert_eq!(Priority::from_str(\"p1\").unwrap(), Priority::HIGH);\nassert!(Priority::from_str(\"P5\").is_err());\nassert!(Priority::CRITICAL < Priority::BACKLOG);\n```",
          "format": "int32",
          "type": "integer"
        },
        "Status": {
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "$ref": "#/$defs/IssueList",
          "description": "The `list`/`ready`/`blocked`/`search`/`stale` result set (`{\"issues\":[…]}`)."
        },
        {
          "$ref": "#/$defs/CountList",
          "description": "The `count` buckets (`{\"counts\":[…]}`)."
        }
      ],
      "description": "The `query` tool success union (spine §5.3, D25). Both arms are CD-2 object-wrapped (§5.3) so the\n`structuredContent` is always a JSON object, never a bare array. `#[serde(untagged)]` ⇒ the arm's\nwrapper value is emitted directly (`{\"issues\":[…]}` / `{\"counts\":[…]}`).",
      "title": "QueryOutput"
    }
  },
  "dep": {
    "input": {
      "$defs": {
        "DependencyType": {
          "type": "string"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `dep` tool input (spine §5.2 — EXACT shape; was `DepInput2`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Add a dependency edge (cycle-rejecting).",
          "properties": {
            "action": {
              "const": "add",
              "type": "string"
            },
            "agent_name": {
              "default": null,
              "description": "Self-reported agent name (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "dep_type": {
              "$ref": "#/$defs/DependencyType",
              "description": "The dependency type."
            },
            "depends_on_id": {
              "description": "The blocker issue id.",
              "type": "string"
            },
            "harness": {
              "default": null,
              "description": "Self-reported harness identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "issue_id": {
              "description": "The dependent issue id.",
              "type": "string"
            },
            "metadata": {
              "default": null,
              "description": "Optional JSON metadata for the edge.",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "default": null,
              "description": "Self-reported model identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action",
            "issue_id",
            "depends_on_id",
            "dep_type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Remove a dependency edge.",
          "properties": {
            "action": {
              "const": "remove",
              "type": "string"
            },
            "agent_name": {
              "default": null,
              "description": "Self-reported agent name (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "dep_type": {
              "$ref": "#/$defs/DependencyType",
              "description": "The dependency type."
            },
            "depends_on_id": {
              "description": "The blocker issue id.",
              "type": "string"
            },
            "harness": {
              "default": null,
              "description": "Self-reported harness identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "issue_id": {
              "description": "The dependent issue id.",
              "type": "string"
            },
            "model": {
              "default": null,
              "description": "Self-reported model identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action",
            "issue_id",
            "depends_on_id",
            "dep_type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "List the direct edges declared by an issue.",
          "properties": {
            "action": {
              "const": "list",
              "type": "string"
            },
            "id": {
              "description": "The issue id.",
              "type": "string"
            }
          },
          "required": [
            "action",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The dependency subtree rooted at an issue.",
          "properties": {
            "action": {
              "const": "tree",
              "type": "string"
            },
            "id": {
              "description": "The root issue id.",
              "type": "string"
            }
          },
          "required": [
            "action",
            "id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Detect dependency cycles.",
          "properties": {
            "action": {
              "const": "cycles",
              "type": "string"
            },
            "blocking_only": {
              "default": true,
              "description": "Restrict to gating edges only (default TRUE; `false` = all dep types, D19).",
              "type": "boolean"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The dependency graph for a root set (empty roots = the whole graph).",
          "properties": {
            "action": {
              "const": "graph",
              "type": "string"
            },
            "roots": {
              "default": [],
              "description": "The root ids (empty = the whole graph).",
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        }
      ],
      "title": "DepToolInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "CycleList": {
          "description": "The CD-2 object-wrap for `dep{cycles}` witnesses: `{\"cycles\":[…]}` (spine §5.3) — each cycle is an\nordered list of issue ids.",
          "properties": {
            "cycles": {
              "description": "The ordered cycle-path witnesses.",
              "items": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "type": "array"
            }
          },
          "required": [
            "cycles"
          ],
          "type": "object"
        },
        "DepAdded": {
          "description": "The `dep add` acknowledgement (`{\"added\":true}`) — a typed shape for the pre-D25 ad-hoc value.",
          "properties": {
            "added": {
              "description": "Always `true` on a successful add.",
              "type": "boolean"
            }
          },
          "required": [
            "added"
          ],
          "type": "object"
        },
        "DepList": {
          "description": "The CD-2 object-wrap for `dep{list}` edges: `{\"deps\":[…]}` (spine §5.3).",
          "properties": {
            "deps": {
              "description": "The direct dependency edges.",
              "items": {
                "$ref": "#/$defs/Dependency"
              },
              "type": "array"
            }
          },
          "required": [
            "deps"
          ],
          "type": "object"
        },
        "DepRemoved": {
          "description": "The `dep remove` acknowledgement (`{\"removed\":true}`) — a typed shape for the pre-D25 ad-hoc value.",
          "properties": {
            "removed": {
              "description": "Always `true` on a successful remove.",
              "type": "boolean"
            }
          },
          "required": [
            "removed"
          ],
          "type": "object"
        },
        "DepTree": {
          "description": "A dependency tree/graph rooted at one or more issues.",
          "properties": {
            "edges": {
              "description": "The edges of the tree/graph.",
              "items": {
                "$ref": "#/$defs/GraphEdge"
              },
              "type": "array"
            },
            "root": {
              "description": "The root issue id.",
              "type": "string"
            }
          },
          "required": [
            "root",
            "edges"
          ],
          "type": "object"
        },
        "Dependency": {
          "description": "A relationship between two issues (spine §1.7).",
          "properties": {
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "created_by": {
              "description": "Who created the edge.",
              "type": [
                "string",
                "null"
              ]
            },
            "depends_on_id": {
              "description": "The issue being depended on (target).",
              "type": "string"
            },
            "issue_id": {
              "description": "The issue that has the dependency (source).",
              "type": "string"
            },
            "metadata": {
              "description": "Optional JSON metadata. A degenerate empty (or whitespace-only) string is coerced to\n`None` on deserialization to tolerate legacy JSONL that wrote `\"metadata\":\"\"`.",
              "type": [
                "string",
                "null"
              ]
            },
            "thread_id": {
              "description": "Thread id for conversation linking.",
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "$ref": "#/$defs/DependencyType",
              "description": "The kind of dependency."
            }
          },
          "required": [
            "issue_id",
            "depends_on_id",
            "type",
            "created_at"
          ],
          "type": "object"
        },
        "DependencyType": {
          "type": "string"
        },
        "GraphEdge": {
          "description": "A directed dependency edge.",
          "properties": {
            "dep_type": {
              "$ref": "#/$defs/DependencyType",
              "description": "The dependency type."
            },
            "from": {
              "description": "The source issue id.",
              "type": "string"
            },
            "to": {
              "description": "The target issue id.",
              "type": "string"
            }
          },
          "required": [
            "from",
            "to",
            "dep_type"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "$ref": "#/$defs/DepAdded",
          "description": "`add` acknowledgement (`{\"added\":true}`)."
        },
        {
          "$ref": "#/$defs/DepRemoved",
          "description": "`remove` acknowledgement (`{\"removed\":true}`)."
        },
        {
          "$ref": "#/$defs/DepList",
          "description": "The direct edges declared by an issue (`list`), CD-2 object-wrapped as `{\"deps\":[…]}`."
        },
        {
          "$ref": "#/$defs/DepTree",
          "description": "The dependency `tree` OR `graph` (`Session::dependency_graph` returns a `DepTree`)."
        },
        {
          "$ref": "#/$defs/CycleList",
          "description": "The ordered cycle-path witnesses (`cycles`, §3.2.1/D19), CD-2 object-wrapped as `{\"cycles\":[…]}`."
        }
      ],
      "description": "The `dep` tool success union (spine §5.3, D25). `#[serde(untagged)]` ⇒ wire-identical to the\npre-D25 ad-hoc `json!` values.",
      "title": "DepOutput"
    }
  },
  "sync": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `sync` tool input (spine §5.2 — EXACT shape).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Export the store to JSONL (default path `.unblock/issues.jsonl`).",
          "properties": {
            "action": {
              "const": "export",
              "type": "string"
            },
            "path": {
              "default": null,
              "description": "Optional export path (path-confined to the workspace).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Import JSONL.",
          "properties": {
            "action": {
              "const": "import",
              "type": "string"
            },
            "dry_run": {
              "default": false,
              "description": "Plan-only: report the import without writing.",
              "type": "boolean"
            },
            "path": {
              "description": "The JSONL path to import.",
              "type": "string"
            }
          },
          "required": [
            "action",
            "path"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "One-shot, idempotent `bd` import (D16).",
          "properties": {
            "action": {
              "const": "import_bd",
              "type": "string"
            },
            "path": {
              "description": "The `bd` export path to import.",
              "type": "string"
            }
          },
          "required": [
            "action",
            "path"
          ],
          "type": "object"
        }
      ],
      "title": "SyncInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "ExportReport": {
          "description": "The report of a JSONL export operation (FR-7).",
          "properties": {
            "path": {
              "description": "The path written to (serialized as a string).",
              "type": "string"
            },
            "written": {
              "description": "Number of issues written.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "written",
            "path"
          ],
          "type": "object"
        },
        "ImportReport": {
          "description": "The report of a JSONL/bd import operation (FR-8/FR-26).\n\n`dependencies`/`comments` count the relations/comments of the issues ACTUALLY inserted by the\none-shot `bd` import (the applied subset — D24/F1), matching bd's applied-subset scoping (its\n`record_imported_relation_counts` runs only on applied Insert/Update records, never on a Skip). So\nan idempotent rerun (all records Skipped) reports `dependencies=0, comments=0`. Both stay `0` on\nthe generic `import_jsonl` path (it never tallies them).",
          "properties": {
            "comments": {
              "description": "Comments on the applied (actually-inserted) subset (`0` on a full-Skip rerun and on the\ngeneric `import_jsonl` path).",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "dependencies": {
              "description": "Dependency edges on the applied (actually-inserted) subset (`0` on a full-Skip rerun and on\nthe generic `import_jsonl` path).",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "dropped_fields": {
              "description": "Fields dropped during import.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "imported": {
              "description": "Number of issues imported.",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            },
            "skipped": {
              "description": "Number of lines skipped (no-ops / rejected).",
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "imported",
            "skipped",
            "dependencies",
            "comments",
            "dropped_fields"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `sync` tool output: an export or import report (spine §5.3, G-23a).\n\nAn mcp-owned wrapper over the two model report DTOs (re-exported from `unblock-model`).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A JSONL export report.",
          "properties": {
            "export": {
              "$ref": "#/$defs/ExportReport"
            }
          },
          "required": [
            "export"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A JSONL/bd import report.",
          "properties": {
            "import": {
              "$ref": "#/$defs/ImportReport"
            }
          },
          "required": [
            "import"
          ],
          "type": "object"
        }
      ],
      "title": "SyncOutput"
    }
  },
  "diagnostics": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `diagnostics` tool input (spine §5.2 — EXACT shape; mirrors [`DiagnosticKind`]).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Aggregate statistics.",
          "properties": {
            "kind": {
              "const": "stats",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "General workspace info.",
          "properties": {
            "kind": {
              "const": "info",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Where the workspace lives.",
          "properties": {
            "kind": {
              "const": "where",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Version information (embeds the contract version).",
          "properties": {
            "kind": {
              "const": "version",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Lint findings.",
          "properties": {
            "kind": {
              "const": "lint",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The changelog of closed issues (the `since` window is T2.7; dropped here).",
          "properties": {
            "kind": {
              "const": "changelog",
              "type": "string"
            },
            "since": {
              "default": null,
              "description": "Optional since-window (accepted but not yet threaded — T2.7).",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Orphan candidates (FR-15).",
          "properties": {
            "kind": {
              "const": "orphans",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        }
      ],
      "title": "DiagnosticsInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "DiagnosticFinding": {
          "description": "A single generic key/value diagnostic finding row (CF-B).",
          "properties": {
            "detail": {
              "description": "The finding detail.",
              "type": "string"
            },
            "label": {
              "description": "The finding label.",
              "type": "string"
            }
          },
          "required": [
            "label",
            "detail"
          ],
          "type": "object"
        },
        "DiagnosticKind": {
          "description": "The kind of a diagnostic probe (CF-B; mirrors the spine §5.2 `DiagnosticsInput` kinds).",
          "oneOf": [
            {
              "const": "stats",
              "description": "Aggregate statistics.",
              "type": "string"
            },
            {
              "const": "info",
              "description": "General workspace info.",
              "type": "string"
            },
            {
              "const": "where",
              "description": "Where the workspace lives.",
              "type": "string"
            },
            {
              "const": "version",
              "description": "Version information.",
              "type": "string"
            },
            {
              "const": "lint",
              "description": "Lint findings.",
              "type": "string"
            },
            {
              "const": "changelog",
              "description": "The changelog of closed issues.",
              "type": "string"
            },
            {
              "const": "orphans",
              "description": "Orphan candidates (FR-15).",
              "type": "string"
            }
          ]
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "A diagnostic report — a kind plus a list of findings (CF-B).",
      "properties": {
        "findings": {
          "description": "The findings.",
          "items": {
            "$ref": "#/$defs/DiagnosticFinding"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/DiagnosticKind",
          "description": "The kind of diagnostic."
        }
      },
      "required": [
        "kind",
        "findings"
      ],
      "title": "DiagnosticReport",
      "type": "object"
    }
  },
  "comment": {
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "description": "The `comment` tool input (spine §5.2 — EXACT shape).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Add a comment to an issue.",
          "properties": {
            "action": {
              "const": "add",
              "type": "string"
            },
            "agent_name": {
              "default": null,
              "description": "Self-reported agent name (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "description": "The comment body.",
              "type": "string"
            },
            "harness": {
              "default": null,
              "description": "Self-reported harness identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "issue_id": {
              "description": "The issue id to comment on.",
              "type": "string"
            },
            "model": {
              "default": null,
              "description": "Self-reported model identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action",
            "issue_id",
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "List the comments on an issue.",
          "properties": {
            "action": {
              "const": "list",
              "type": "string"
            },
            "issue_id": {
              "description": "The issue id.",
              "type": "string"
            }
          },
          "required": [
            "action",
            "issue_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Update a comment's body (provenance-preserving: sets `updated_at`, audits the edit).",
          "properties": {
            "action": {
              "const": "update",
              "type": "string"
            },
            "agent_name": {
              "default": null,
              "description": "Self-reported agent name (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "description": "The new comment body.",
              "type": "string"
            },
            "comment_id": {
              "description": "The comment id.",
              "format": "int64",
              "type": "integer"
            },
            "harness": {
              "default": null,
              "description": "Self-reported harness identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "default": null,
              "description": "Self-reported model identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action",
            "comment_id",
            "body"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Delete a comment — a SOFT-REDACT: the row is kept, the body masked, `redacted_at` set. The\noriginal body is retained in the audit trail — a mask, not erasure.",
          "properties": {
            "action": {
              "const": "delete",
              "type": "string"
            },
            "agent_name": {
              "default": null,
              "description": "Self-reported agent name (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "comment_id": {
              "description": "The comment id.",
              "format": "int64",
              "type": "integer"
            },
            "harness": {
              "default": null,
              "description": "Self-reported harness identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            },
            "model": {
              "default": null,
              "description": "Self-reported model identifier (capture-only).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "action",
            "comment_id"
          ],
          "type": "object"
        }
      ],
      "title": "CommentToolInput",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Comment": {
          "description": "A comment on an issue (spine §1.7; v1 surface — D37). Flat: no threading (FORK-T).",
          "properties": {
            "author": {
              "description": "The comment author (= the session actor at the MCP surface, FORK-M1b).",
              "type": "string"
            },
            "created_at": {
              "description": "Creation timestamp.",
              "format": "date-time",
              "type": "string"
            },
            "id": {
              "description": "Stable comment id.",
              "format": "int64",
              "type": "integer"
            },
            "issue_id": {
              "description": "The issue this comment belongs to.",
              "type": "string"
            },
            "redacted_at": {
              "description": "Soft-redact marker (D37/D-E): `None` = live; `Some` = redacted.\n\nThe PRESENCE is the \"is redacted\" flag (mirroring the tombstone `deleted_at`); on redact the\nrow is KEPT and `body` is masked to `\"\"`. The `CommentRedacted` audit event retains the\noriginal body (provenance — FORK-redact-wire).",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            },
            "text": {
              "description": "The comment body (serialized under `\"text\"`); masked to `\"\"` on redact.",
              "type": "string"
            },
            "updated_at": {
              "description": "Provenance-preserving edit instant (D37/D-D): `None` = never edited; `Some` = last edit.\n\n`add`'s own INSERT is create-time-only — see spine §3.2.1 MUST-1 SCOPE.",
              "format": "date-time",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id",
            "issue_id",
            "author",
            "text",
            "created_at"
          ],
          "type": "object"
        },
        "CommentList": {
          "description": "The CD-2 object-wrap for `comment{list}`: `{\"comments\":[…]}` (spine §5.3) — never a bare array.",
          "properties": {
            "comments": {
              "description": "The comments on the issue, in canonical order (`created_at ASC, id ASC`).",
              "items": {
                "$ref": "#/$defs/Comment"
              },
              "type": "array"
            }
          },
          "required": [
            "comments"
          ],
          "type": "object"
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "anyOf": [
        {
          "$ref": "#/$defs/Comment",
          "description": "The single affected comment (`add` / `update` / `delete`-as-redact)."
        },
        {
          "$ref": "#/$defs/CommentList",
          "description": "The comments on an issue (`list`), CD-2 object-wrapped as `{\"comments\":[…]}`."
        }
      ],
      "description": "The `comment` tool success union (spine §5.3, FR-6/D37). `#[serde(untagged)]`.\n\nOne scalar arm — `add`/`update`/`delete` all return the single affected `Comment`, exactly as\n`IssueOutput::Issue` covers create/show/reopen/restore — plus one CD-2 object-wrapped list arm.\n`Comment` is small, so no `Box` is needed.\n\nThe **redact wire form** is simply the returned `Comment` with `redacted_at` present and\n`\"text\": \"\"` — there is NO extra top-level `\"redacted\"` bool: the presence of `redacted_at` IS\nthe flag, mirroring the tombstone `deleted_at` (spine §1.7).",
      "title": "CommentOutput"
    }
  },
  "error": {
    "$defs": {
      "ErrorCode": {
        "description": "Machine-readable, stable error codes (spine §2.2).\n\nThese codes are stable across versions and serialize as `SCREAMING_SNAKE_CASE` JSON\nstrings (e.g. `ErrorCode::IssueNotFound` ↔ `\"ISSUE_NOT_FOUND\"`). Each maps to exactly one\n0–8 exit code via [`ErrorCode::exit_code`] (spine §2.3, golden-snapshot pinned, FR-11).\n\nNew variants are added **additively** in later versions (never renumbered) so the golden\nexit-code snapshot only ever grows.",
        "oneOf": [
          {
            "const": "DATABASE_NOT_FOUND",
            "description": "Database file not found.",
            "type": "string"
          },
          {
            "const": "DATABASE_LOCKED",
            "description": "Database is locked by another process (retryable).",
            "type": "string"
          },
          {
            "const": "SCHEMA_MISMATCH",
            "description": "Database schema version mismatch.",
            "type": "string"
          },
          {
            "const": "DATABASE_ERROR",
            "description": "Database operation failed.",
            "type": "string"
          },
          {
            "const": "NOT_INITIALIZED",
            "description": "Workspace not initialized.",
            "type": "string"
          },
          {
            "const": "ALREADY_INITIALIZED",
            "description": "Workspace already initialized.",
            "type": "string"
          },
          {
            "const": "RATE_LIMITED",
            "description": "The MCP request-rate cap fired: too many concurrent in-flight requests (retryable — back off\nand retry). An MCP-surface concurrency cap (NFR-18/D34), grouped with the exit-2 transient-busy\nfamily by retry semantics — a `DatabaseLocked` sibling, NOT a DB fault (see the spine §2.3 note).",
            "type": "string"
          },
          {
            "const": "ISSUE_NOT_FOUND",
            "description": "Issue with the specified id not found.",
            "type": "string"
          },
          {
            "const": "AMBIGUOUS_ID",
            "description": "A partial id matches multiple issues (retryable: disambiguate and retry).",
            "type": "string"
          },
          {
            "const": "ID_COLLISION",
            "description": "Issue id collision on create.",
            "type": "string"
          },
          {
            "const": "INVALID_ID",
            "description": "Invalid issue id format.",
            "type": "string"
          },
          {
            "const": "NOTHING_TO_DO",
            "description": "Nothing to do — all requested items were skipped.",
            "type": "string"
          },
          {
            "const": "ALREADY_CLAIMED",
            "description": "Atomic claim lost: another actor already claimed the issue (retryable; FR-2).",
            "type": "string"
          },
          {
            "const": "VALIDATION_FAILED",
            "description": "One or more field validations failed (retryable; carries per-field detail).",
            "type": "string"
          },
          {
            "const": "INVALID_STATUS",
            "description": "Invalid status value (retryable).",
            "type": "string"
          },
          {
            "const": "INVALID_TYPE",
            "description": "Invalid issue-type value (retryable).",
            "type": "string"
          },
          {
            "const": "INVALID_PRIORITY",
            "description": "Priority out of range 0..=4 (retryable).",
            "type": "string"
          },
          {
            "const": "REQUIRED_FIELD",
            "description": "A required field is missing (retryable).",
            "type": "string"
          },
          {
            "const": "POLICY_VIOLATION",
            "description": "A closure-time policy gate fired (exit 4, non-retryable).",
            "type": "string"
          },
          {
            "const": "CYCLE_DETECTED",
            "description": "A dependency cycle was detected.",
            "type": "string"
          },
          {
            "const": "DEPENDENCY_NOT_FOUND",
            "description": "The dependency target was not found.",
            "type": "string"
          },
          {
            "const": "HAS_DEPENDENTS",
            "description": "Cannot proceed: the issue has dependents.",
            "type": "string"
          },
          {
            "const": "SELF_DEPENDENCY",
            "description": "An issue cannot depend on itself.",
            "type": "string"
          },
          {
            "const": "DUPLICATE_DEPENDENCY",
            "description": "Duplicate dependency edge.",
            "type": "string"
          },
          {
            "const": "JSONL_PARSE_ERROR",
            "description": "JSONL parse error during import.",
            "type": "string"
          },
          {
            "const": "PREFIX_MISMATCH",
            "description": "Prefix mismatch during import.",
            "type": "string"
          },
          {
            "const": "IMPORT_COLLISION",
            "description": "Import collision detected.",
            "type": "string"
          },
          {
            "const": "SYNC_CONFLICT",
            "description": "Conflict between local database changes and newer JSONL.",
            "type": "string"
          },
          {
            "const": "CONFLICT_MARKERS",
            "description": "Conflict markers present in JSONL.",
            "type": "string"
          },
          {
            "const": "PATH_TRAVERSAL",
            "description": "A path-traversal attempt was blocked.",
            "type": "string"
          },
          {
            "const": "CONFIG_ERROR",
            "description": "Configuration error.",
            "type": "string"
          },
          {
            "const": "CONFIG_NOT_FOUND",
            "description": "Config file not found.",
            "type": "string"
          },
          {
            "const": "CONFIG_PARSE_ERROR",
            "description": "Config parse error.",
            "type": "string"
          },
          {
            "const": "IO_ERROR",
            "description": "File I/O error.",
            "type": "string"
          },
          {
            "const": "JSON_ERROR",
            "description": "JSON serialization error.",
            "type": "string"
          },
          {
            "const": "INTERNAL_ERROR",
            "description": "Unexpected internal error.",
            "type": "string"
          }
        ]
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A machine-parseable, agent-friendly structured error (spine §2.4; FR-11).\n\nCarries a stable [`ErrorCode`], a terminal-sanitized human message, an optional\n(terminal-sanitized) self-correction `hint`, a `retryable` flag (mirrors\n[`ErrorCode::is_retryable`]), and a free-form `context` object. Both `message` and `hint` are\nalways routed through [`crate::sanitize_message`] by every constructor/builder, so neither can\ncarry raw control bytes (spine §2.4 chokepoint). `context` values are terminal-safe only via\nJSON encoding — a text/plain render of any context value must route through a sanitizer.\n\nSerializes to valid JSON in every state: an empty `context` is omitted, and a `None` `hint`\nis omitted, so the payload stays compact.",
    "properties": {
      "code": {
        "$ref": "#/$defs/ErrorCode",
        "description": "The stable error code (serialized as `SCREAMING_SNAKE_CASE`)."
      },
      "context": {
        "additionalProperties": true,
        "description": "Optional structured detail (e.g. `context[\"fields\"]` for validation aggregates).",
        "type": "object"
      },
      "hint": {
        "description": "Optional agent self-correction guidance.",
        "type": [
          "string",
          "null"
        ]
      },
      "message": {
        "description": "Human-readable, terminal-sanitized message.",
        "type": "string"
      },
      "retryable": {
        "description": "Whether the failing operation is potentially retryable (`== code.is_retryable()`).",
        "type": "boolean"
      }
    },
    "required": [
      "code",
      "message",
      "retryable"
    ],
    "title": "StructuredError",
    "type": "object"
  }
}
