---
source: crates/unblock-mcp/tests/contract_suite.rs
expression: capabilities()
---
{
  "contract_version": "unblock.mcp.v1.6",
  "tools": [
    {
      "name": "issue",
      "description": "Create, show, update, close, reopen, delete, or restore issues."
    },
    {
      "name": "claim",
      "description": "Atomically claim an issue for an assignee; the loser of a race is reported."
    },
    {
      "name": "defer",
      "description": "Defer an issue until a future timestamp, or undefer it."
    },
    {
      "name": "query",
      "description": "Query issues: list, ready, blocked, search, count, or stale."
    },
    {
      "name": "dep",
      "description": "Manage and query dependencies: add, remove, list, tree, cycles, or graph."
    },
    {
      "name": "sync",
      "description": "Export/import the issue store as JSONL, or one-shot import a bd export."
    },
    {
      "name": "diagnostics",
      "description": "Diagnostics: stats, info, where, version, lint, changelog, or orphans."
    },
    {
      "name": "comment",
      "description": "Comment on issues: add, list, update, or delete (soft-redact)."
    }
  ],
  "resources": [
    {
      "uri": "unblock://issues/{id}",
      "description": "A single issue by id."
    },
    {
      "uri": "unblock://issues/ready",
      "description": "The default-complete ready set (agent entrypoint)."
    },
    {
      "uri": "unblock://issues/blocked",
      "description": "The blocked set."
    },
    {
      "uri": "unblock://capabilities",
      "description": "This discovery document."
    },
    {
      "uri": "unblock://schema",
      "description": "The JsonSchema bundle for every tool I/O."
    }
  ],
  "prompts": [
    {
      "name": "triage",
      "description": "A guided triage workflow over blocked/unassigned/deferred work."
    },
    {
      "name": "plan_next_work",
      "description": "Drive the ready -> claim selection (FR-20)."
    },
    {
      "name": "close_with_suggestions",
      "description": "Close an issue and surface the newly-unblocked set (FR-11)."
    }
  ],
  "error_codes": [
    {
      "code": "DATABASE_NOT_FOUND",
      "exit_code": 2,
      "retryable": false,
      "hint_shape": "none"
    },
    {
