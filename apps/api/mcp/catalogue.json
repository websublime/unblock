{
  "schema_version": "v0.1",
  "tools": [
    {
      "name": "prime",
      "description": "Single-call dashboard for a fresh agent session: returns ready set summary, claimed-by-me items, recent cascade events, and scoped memory hints (empty in P01).",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "ready_limit": { "type": "integer", "minimum": 1, "maximum": 50 }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["ready_summary", "claimed_by_me", "recent_cascade_events", "memory_hints"],
        "properties": {
          "ready_summary": {
            "type": "object",
            "required": ["count_total", "items"],
            "properties": {
              "count_total": { "type": "integer" },
              "items": { "type": "array", "items": { "$ref": "#/$shared/Item" } }
            }
          },
          "claimed_by_me": { "type": "array", "items": { "$ref": "#/$shared/Item" } },
          "recent_cascade_events": { "type": "array", "items": { "$ref": "#/$shared/CascadeEventRow" } },
          "memory_hints": { "type": "array", "items": { "$ref": "#/$shared/MemoryHint" } }
        }
      }
    },
    {
      "name": "ready",
      "description": "Return the next ready work items for the calling agent's org/project, ordered by (priority asc, created_at asc, id asc), paginated via opaque cursor (§6.2.0).",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "priority_min": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
          "cursor": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["items", "total_ready", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$shared/Item" } },
          "total_ready": { "type": "integer" },
          "next_cursor": { "type": ["string", "null"] }
        }
      }
    },
    {
      "name": "claim",
      "description": "Atomic claim (Manifesto Law 5) — SELECT FOR UPDATE, sets claimed_by_* and Status=InProgress; loser path returns ALREADY_CLAIMED with winner_user_id, winner_agent, claimed_at.",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["claimed", "item"],
        "properties": {
          "claimed": { "type": "boolean" },
          "item": { "$ref": "#/$shared/Item" }
        }
      }
    },
    {
      "name": "create",
      "description": "Create a work item (type=task | epic | finding) with optional parent, milestone, labels, and dependencies. Cycle-checked inline; entire create rejected on cycle.",
      "input_schema": {
        "type": "object",
        "required": ["project_id", "title"],
        "properties": {
          "project_id": { "type": "string" },
          "parent_id": { "type": "string" },
          "discovered_from_id": { "type": "string" },
          "type": { "type": "string", "enum": ["epic", "task", "finding"] },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
          "milestone_id": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["blocker_item_id"],
              "properties": {
                "blocker_item_id": { "type": "string" },
                "kind": { "type": "string", "enum": ["blocks", "related"] }
              },
              "additionalProperties": false
            }
          },
          "severity": { "type": "string" },
          "kind_of_finding": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "$ref": "#/$shared/Item" }
        }
      }
    },
    {
      "name": "update",
      "description": "Update editable item columns (title, body, priority, milestone_id, labels). State dimensions (impl_state, review_state, qa_state, pipeline_state) are rejected with VALIDATION — use set_state instead.",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"] },
          "milestone_id": { "type": ["string", "null"] },
          "labels": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "output_schema": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "$ref": "#/$shared/Item" }
        }
      }
    },
    {
      "name": "close",
      "description": "Flip an item to Done. Rejects with PRECONDITION_NOT_MET (data.missing=claimed_by_id) when not currently claimed. Emits CascadeRequested{Reason:\"close\"} post-commit.",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "$ref": "#/$shared/Item" }
        }
      }
    },
    {
      "name": "show",
      "description": "Return one item with its full comment trail, dependencies (in + out), and finding children. Inclusion flags default to true.",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" },
          "include_comments": { "type": "boolean" },
          "include_dependencies": { "type": "boolean" },
          "include_findings": { "type": "boolean" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["item", "comments", "dependencies_in", "dependencies_out", "findings"],
        "properties": {
          "item": { "$ref": "#/$shared/Item" },
          "comments": { "type": "array", "items": { "$ref": "#/$shared/Comment" } },
          "dependencies_in": { "type": "array", "items": { "$ref": "#/$shared/Edge" } },
          "dependencies_out": { "type": "array", "items": { "$ref": "#/$shared/Edge" } },
          "findings": { "type": "array", "items": { "$ref": "#/$shared/Item" } }
        }
      }
    },
    {
      "name": "list",
      "description": "List items by org/project/milestone/label with filters on status, pipeline_stage, claimed_by, labels. Paginates via opaque cursor (§6.2.0).",
      "input_schema": {
        "type": "object",
        "properties": {
          "project_id": { "type": "string" },
          "milestone_id": { "type": "string" },
          "status": { "type": "array", "items": { "type": "string" } },
          "pipeline_stage": { "type": "array", "items": { "type": "string" } },
          "claimed_by": { "type": "string" },
          "labels": { "type": "array", "items": { "type": "string" } },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200 },
          "cursor": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["items", "next_cursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/$shared/Item" } },
          "next_cursor": { "type": ["string", "null"] }
        }
      }
    },
    {
      "name": "search",
      "description": "Full-text search across item titles + bodies + comment bodies (websearch_to_tsquery format); respects RBAC. Paginates via opaque cursor (§6.2.0).",
      "input_schema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "project_id": { "type": "string" },
          "query": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "cursor": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["hits", "next_cursor"],
        "properties": {
          "hits": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["item_id", "source", "comment_id", "rank", "snippet"],
              "properties": {
                "item_id": { "type": "string" },
                "source": { "type": "string", "enum": ["item", "comment"] },
                "comment_id": { "type": ["string", "null"] },
                "rank": { "type": "number" },
                "snippet": { "type": "string" }
              }
            }
          },
          "next_cursor": { "type": ["string", "null"] }
        }
      }
    },
    {
      "name": "comment",
      "description": "Append a structured (kind, status, body) comment to an item; comments are append-only (FR-10). Body is 1..16384 chars enforced at the MCP boundary.",
      "input_schema": {
        "type": "object",
        "required": ["item_id", "body"],
        "properties": {
          "item_id": { "type": "string" },
          "parent_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["investigation", "decision", "deviation", "completed", "review", "qa", "deferred", "pr", "needs-human", "override", "general"] },
          "status": { "type": "string", "enum": ["error", "warning", "info", "success"] },
          "body": { "type": "string", "minLength": 1, "maxLength": 16384 }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["comment"],
        "properties": {
          "comment": { "$ref": "#/$shared/Comment" }
        }
      }
    },
    {
      "name": "add_dependency",
      "description": "Add a `from blocks to` edge; cycle-checked at write time (NFR-5). Cross-project edges rejected with VALIDATION. Emits CascadeRequested{Reason:\"edge_added\"} post-commit.",
      "input_schema": {
        "type": "object",
        "required": ["from_item_id", "to_item_id"],
        "properties": {
          "from_item_id": { "type": "string" },
          "to_item_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["blocks", "related"] }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["edge"],
        "properties": {
          "edge": { "$ref": "#/$shared/Edge" }
        }
      }
    },
    {
      "name": "remove_dependency",
      "description": "Remove an edge; accepts edge_id OR composite (from_item_id, to_item_id, kind). Recomputes is_ready inline for the direct to_item; emits CascadeRequested{Reason:\"edge_removed\"} post-commit.",
      "input_schema": {
        "type": "object",
        "properties": {
          "edge_id": { "type": "string" },
          "from_item_id": { "type": "string" },
          "to_item_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["blocks", "related"] }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["removed", "to_item_now_ready"],
        "properties": {
          "removed": { "type": "boolean" },
          "to_item_now_ready": { "type": "boolean" }
        }
      }
    },
    {
      "name": "set_state",
      "description": "Set one or more of (impl_state, review_state, qa_state, pipeline_state) atomically. Enforces the five PRD §6.2 state-machine invariants I-1..I-5. Layer-1 BLOCK conditions ship in P02. Emits CascadeRequested{Reason:\"state_change\"} when the write affects §5.7.1 pipeline_stage derivation.",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" },
          "impl_state": { "type": "string", "enum": ["pending", "done"] },
          "review_state": { "type": "string", "enum": ["pending", "approved", "needs_rework"] },
          "qa_state": { "type": "string", "enum": ["pending", "passed", "failed"] },
          "pipeline_state": { "type": "string", "enum": ["running", "needs_human", "paused", "no_investigation"] },
          "intent_comment": {
            "type": "object",
            "required": ["kind", "status", "body"],
            "properties": {
              "kind": { "type": "string", "enum": ["investigation", "decision", "deviation", "completed", "review", "qa", "deferred", "pr", "needs-human", "override", "general"] },
              "status": { "type": "string", "enum": ["error", "warning", "info", "success"] },
              "body": { "type": "string", "minLength": 1, "maxLength": 16384 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "$ref": "#/$shared/Item" }
        }
      }
    },
    {
      "name": "get_state",
      "description": "Return the four state columns + the derived pipeline_stage + is_ready + claim columns + the most recent (kind, status) per comment trail (one row per distinct kind).",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["project_id", "impl_state", "review_state", "qa_state", "pipeline_state", "pipeline_stage", "is_ready", "claimed_by_id", "claimed_at", "recent_kinds"],
        "properties": {
          "project_id": { "type": "string" },
          "impl_state": { "type": "string" },
          "review_state": { "type": "string" },
          "qa_state": { "type": "string" },
          "pipeline_state": { "type": "string" },
          "pipeline_stage": { "type": ["string", "null"] },
          "is_ready": { "type": "boolean" },
          "claimed_by_id": { "type": ["string", "null"] },
          "claimed_at": { "type": ["string", "null"] },
          "recent_kinds": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "status", "comment_id", "created_at"],
              "properties": {
                "kind": { "type": "string" },
                "status": { "type": "string" },
                "comment_id": { "type": "string" },
                "created_at": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "name": "promote",
      "description": "Promote a Backlog item to Ready so it enters the ready queue and becomes claimable. Precondition: status=Backlog AND is_ready=true (no open blockers). Rejects with PRECONDITION_NOT_MET carrying data.status (current Status), data.required=Ready, and data.missing=is_ready when the item is Backlog but still blocked. Side-effect free on the cascade subsystem.",
      "input_schema": {
        "type": "object",
        "required": ["item_id"],
        "properties": {
          "item_id": { "type": "string" }
        },
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "required": ["item"],
        "properties": {
          "item": { "$ref": "#/$shared/Item" }
        }
      }
    }
  ],
  "transitions": [],
  "$shared": {
    "Item": {
      "type": "object",
      "required": ["id", "org_id", "type", "title", "status", "priority", "is_ready", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "org_id": { "type": "string" },
        "project_id": { "type": "string" },
        "milestone_id": { "type": "string" },
        "parent_id": { "type": "string" },
        "discovered_from_id": { "type": "string" },
        "type": { "type": "string", "enum": ["epic", "task", "finding"] },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "pipeline_stage": { "type": "string" },
        "agent_kind": { "type": "string" },
        "impl_state": { "type": "string" },
        "review_state": { "type": "string" },
        "qa_state": { "type": "string" },
        "pipeline_state": { "type": "string" },
        "severity": { "type": "string" },
        "kind_of_finding": { "type": "string" },
        "claimed_by_id": { "type": "string" },
        "claimed_by_agent": { "type": "string" },
        "claimed_at": { "type": "string" },
        "is_ready": { "type": "boolean" },
        "milestone_assigned_at": { "type": "string" },
        "milestone_assigned_by": { "type": "string" },
        "labels": { "type": "array", "items": { "type": "string" } },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "closed_at": { "type": "string" }
      }
    },
    "Comment": {
      "type": "object",
      "required": ["id", "item_id", "kind", "status", "body", "created_at", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "item_id": { "type": "string" },
        "parent_id": { "type": "string" },
        "author_id": { "type": "string" },
        "author_agent": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "type": "string" },
        "body": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "Edge": {
      "type": "object",
      "required": ["id", "from_item", "to_item", "kind", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "from_item": { "type": "string" },
        "to_item": { "type": "string" },
        "kind": { "type": "string" },
        "created_at": { "type": "string" },
        "created_by": { "type": "string" }
      }
    },
    "CascadeEventRow": {
      "type": "object",
      "required": ["id", "event_id", "affected_item_ids", "cascaded_count", "triggered_at"],
      "properties": {
        "id": { "type": "string" },
        "event_id": { "type": "string" },
        "triggered_by_item_id": { "type": "string" },
        "affected_item_ids": { "type": "array", "items": { "type": "string" } },
        "cascaded_count": { "type": "integer" },
        "triggered_at": { "type": "string" },
        "trace_id": { "type": "string" }
      }
    },
    "MemoryHint": {
      "type": "object",
      "required": ["source", "body"],
      "properties": {
        "source": { "type": "string" },
        "body": { "type": "string" }
      }
    }
  }
}
