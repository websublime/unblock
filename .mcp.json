{
  "mcpServers": {
    "unblock": {
      "command": "sh",
      "args": ["-c", "root=$(cd \"$(git rev-parse --path-format=absolute --git-common-dir)/..\" && pwd) && exec \"$root/target/debug/unblock\" --dir \"$root/.unblock\" mcp"]
    },
    "codebase-memory": {
      "command": "codebase-memory-mcp",
      "args": ["serve"]
    }
  }
}
